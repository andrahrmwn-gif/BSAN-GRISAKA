{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student roster, attendance status, and discipline counters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nisn": { "type": "string" },
        "nama": { "type": "string" },
        "kelas": { "type": "string" },
        "jenjang": { "type": "number" },
        "gender": { "type": "string" },
        "noHpSiswa": { "type": "string" },
        "namaOrtu": { "type": "string" },
        "noWaOrtu": { "type": "string" },
        "alamat": { "type": "string" },
        "statusKehadiran": { "type": "string" },
        "statusKehadiranDate": { "type": "string" },
        "keteranganKehadiran": { "type": "string" },
        "totalPelanggaranRingan": { "type": "number" },
        "totalPelanggaranSedang": { "type": "number" },
        "totalPelanggaranBerat": { "type": "number" },
        "totalPoinPelanggaran": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nama", "kelas"]
    },
    "ViolationRecord": {
      "title": "ViolationRecord",
      "description": "Student discipline and violation log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "kelas": { "type": "string" },
        "pasalId": { "type": "string" },
        "pasalNumber": { "type": "number" },
        "pasalTitle": { "type": "string" },
        "kodePasal": { "type": "string" },
        "uraian": { "type": "string" },
        "tingkat": { "type": "string" },
        "tanggal": { "type": "string" },
        "waktu": { "type": "string" },
        "lokasi": { "type": "string" },
        "guruPencatat": { "type": "string" },
        "tahapPembinaan": { "type": "string" },
        "statusSurat": { "type": "string" },
        "catatanKhusus": { "type": "string" },
        "noWaOrtu": { "type": "string" },
        "namaOrtu": { "type": "string" },
        "poin": { "type": "number" }
      },
      "required": ["id", "studentId", "studentName", "kelas", "tingkat", "tanggal"]
    },
    "WhatsAppMessageLog": {
      "title": "WhatsAppMessageLog",
      "description": "Sent notification logs to parents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "kelas": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "triggerType": { "type": "string" }
      },
      "required": ["id", "studentName", "message", "timestamp"]
    },
    "AttendanceSheet": {
      "title": "AttendanceSheet",
      "description": "Daily attendance sheet for a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "kelas": { "type": "string" },
        "recordedBy": { "type": "string" },
        "recordedByNip": { "type": "string" },
        "recordedAt": { "type": "string" },
        "entries": { "type": "array" },
        "summary": { "type": "object" },
        "revision": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date", "kelas", "entries", "summary"]
    },
    "SchoolConfig": {
      "title": "SchoolConfig",
      "description": "School profile settings (profile) and master security lock metadata (system_meta)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "npsn": { "type": "string" },
        "address": { "type": "string" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" },
        "studentsInitialized": { "type": "boolean" },
        "accountsInitialized": { "type": "boolean" },
        "isCleanReset": { "type": "boolean" },
        "isDataLocked": { "type": "boolean" },
        "dataLockedUpdatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "SchoolActivity": {
      "title": "SchoolActivity",
      "description": "School events and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "startDate"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Staff and teacher account configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "nip": { "type": "string" },
        "pin": { "type": "string" },
        "isActive": { "type": "boolean" },
        "canEdit": { "type": "boolean" },
        "canDelete": { "type": "boolean" },
        "canManageSettings": { "type": "boolean" },
        "avatarColor": { "type": "string" }
      },
      "required": ["id", "name", "role", "username", "isActive", "canEdit"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Real-time system audit and security activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "isoTimestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "actionType": { "type": "string" },
        "module": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "isoTimestamp", "userId", "actionType", "module", "description"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of student records"
    },
    "/violations/{violationId}": {
      "schema": "ViolationRecord",
      "description": "Discipline violation records"
    },
    "/wa_logs/{logId}": {
      "schema": "WhatsAppMessageLog",
      "description": "WhatsApp dispatch logs"
    },
    "/attendance_sheets/{sheetId}": {
      "schema": "AttendanceSheet",
      "description": "Class daily attendance sheets"
    },
    "/school_config/{configId}": {
      "schema": "SchoolConfig",
      "description": "School profile and system_meta operational lock configurations"
    },
    "/activities/{activityId}": {
      "schema": "SchoolActivity",
      "description": "School announcements and activities"
    },
    "/accounts/{accountId}": {
      "schema": "UserAccount",
      "description": "Staff user credentials and role definitions"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Real-time system audit and security logs across all devices"
    }
  }
}
